# Optional. Keys are normally added in the app (API button, top bar).
# Copy to .env.local (ignored by Git) only if you prefer a file-based key.
AI_PROVIDER=openai          # openai | gemini
AI_API_KEY=
AI_MODEL=gpt-image-2.5-sunburst   # for gemini: gemini-3.1-flash-image

# OpenAI only: model that drives the image_generation tool.
OPENAI_TEXT_MODEL=gpt-6-astra

# Optional
API_PORT=3001
# DATA_DIR=./data
